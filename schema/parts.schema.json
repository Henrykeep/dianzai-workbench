{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "器件/方案库 tools/catalog/parts.yaml（tools/scheme.py）",
  "type": "object", "required": ["schema_version", "parts"], "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "parts": { "type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "kind", "provides", "pros", "cons", "substitutes", "repo", "status"],
      "if": { "properties": { "price_cny": { "type": "number" } }, "required": ["price_cny"] }, "then": { "required": ["price_note"] },
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" }, "name": { "type": "string" },
        "kind": { "enum": ["mcu", "coproc", "sensor", "actuator", "ui", "link"] },
        "provides": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "tags": { "type": "array", "items": { "type": "string" } },
        "bus": { "enum": ["uart", "i2c", "spi", "pwm", "gpio", "adc", "qei", "usb"] },
        "specs": { "type": "object" },
        "pros": { "type": "array", "items": { "type": "string" } },
        "cons": { "type": "array", "items": { "type": "string" } },
        "risks": { "type": "array", "items": { "type": "string" } },
        "substitutes": { "type": "array", "items": { "type": "string" } },
        "repo": { "type": "array", "items": { "type": "string" } },
        "status": { "enum": ["上板", "仿真", "编译", "无驱动"] },
        "price_cny": { "type": "number", "minimum": 0 }, "price_note": { "type": "string" },
        "power_w": { "type": "number", "minimum": 0 },
        "mcu": { "type": "object" },
        "res": { "type": "array", "items": { "type": "object", "required": ["type", "names"], "additionalProperties": false,
          "properties": { "type": { "enum": ["gpio", "pwm", "encoder", "uart", "i2c", "spi", "adc"] },
            "names": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }, "minItems": 1 },
            "dir": { "enum": ["in", "out"] }, "freq_hz": { "type": "integer" }, "baud": { "type": "integer" },
            "speed_hz": { "type": "integer" }, "irq": { "type": "integer", "minimum": 0, "maximum": 15 } } } }
      } } }
  }
}
