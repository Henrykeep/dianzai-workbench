<?xml version="1.0" encoding="UTF-8"?>
<!-- 由 tools/gen_ccs_projectspec.py 生成，勿手改；改源文件列表后重跑。【未验证】未在 CCS 中导入编译。
     导入前先在仓库根目录跑：make BOARD=mspm0g3507-launchpad APP=car_2wd gen   （生成 build/mspm0g3507-launchpad/gen/board_gen.c） -->
<projectSpec>
    <applicability>
        <when>
            <context deviceFamily="ARM" deviceId="MSPM0G3507"/>
        </when>
    </applicability>

    <project
        title="mspm0g3507-launchpad_car_2wd"
        name="mspm0g3507-launchpad_car_2wd"
        configurations="Debug"
        toolChain="TICLANG"
        connection="TIXDS110_Connection.xml"
        device="MSPM0G3507"
        ignoreDefaultDeviceSettings="true"
        ignoreDefaultCCSSettings="true"
        products="MSPM0-SDK;sysconfig"
        compilerBuildOptions="
            -I${PROJECT_ROOT}
            -I${PROJECT_ROOT}/${ConfigName}
            -I${PROJECT_LOC}/../../../firmware/common
            -I${PROJECT_LOC}/../../../firmware/pal
            -I${PROJECT_LOC}/../../../firmware/algo/abobs
            -I${PROJECT_LOC}/../../../firmware/algo/accel_ff
            -I${PROJECT_LOC}/../../../firmware/algo/attitude
            -I${PROJECT_LOC}/../../../firmware/algo/ball_beam
            -I${PROJECT_LOC}/../../../firmware/algo/capfreq
            -I${PROJECT_LOC}/../../../firmware/algo/dds
            -I${PROJECT_LOC}/../../../firmware/algo/follow
            -I${PROJECT_LOC}/../../../firmware/algo/line_obs
            -I${PROJECT_LOC}/../../../firmware/algo/lpf
            -I${PROJECT_LOC}/../../../firmware/algo/mtspeed
            -I${PROJECT_LOC}/../../../firmware/algo/pid
            -I${PROJECT_LOC}/../../../firmware/algo/sigfilt
            -I${PROJECT_LOC}/../../../firmware/algo/slew
            -I${PROJECT_LOC}/../../../firmware/algo/spectrum
            -I${PROJECT_LOC}/../../../firmware/algo/stall
            -I${PROJECT_LOC}/../../../firmware/algo/vision
            -I${PROJECT_LOC}/../../../firmware/framework/blackbox
            -I${PROJECT_LOC}/../../../firmware/framework/coord
            -I${PROJECT_LOC}/../../../firmware/framework/menu
            -I${PROJECT_LOC}/../../../firmware/framework/persist
            -I${PROJECT_LOC}/../../../firmware/framework/rtosmon
            -I${PROJECT_LOC}/../../../firmware/framework/safety
            -I${PROJECT_LOC}/../../../firmware/framework/spsc
            -I${PROJECT_LOC}/../../../firmware/framework/subsys
            -I${PROJECT_LOC}/../../../firmware/proto/dzctl
            -I${PROJECT_LOC}/../../../firmware/proto/dzframe
            -I${PROJECT_LOC}/../../../firmware/proto/dzimu
            -I${PROJECT_LOC}/../../../firmware/proto/dzrtt
            -I${PROJECT_LOC}/../../../firmware/proto/peerlink
            -I${PROJECT_LOC}/../../../firmware/drivers/battery
            -I${PROJECT_LOC}/../../../firmware/drivers/bmi088
            -I${PROJECT_LOC}/../../../firmware/drivers/bt_serial
            -I${PROJECT_LOC}/../../../firmware/drivers/buzzer
            -I${PROJECT_LOC}/../../../firmware/drivers/encoder
            -I${PROJECT_LOC}/../../../firmware/drivers/hcsr04
            -I${PROJECT_LOC}/../../../firmware/drivers/key
            -I${PROJECT_LOC}/../../../firmware/drivers/keypad4x4
            -I${PROJECT_LOC}/../../../firmware/drivers/line_sensor
            -I${PROJECT_LOC}/../../../firmware/drivers/motor_2pwm
            -I${PROJECT_LOC}/../../../firmware/drivers/motor_dc
            -I${PROJECT_LOC}/../../../firmware/drivers/mpu6050
            -I${PROJECT_LOC}/../../../firmware/drivers/nvm_pal
            -I${PROJECT_LOC}/../../../firmware/drivers/qd4310
            -I${PROJECT_LOC}/../../../firmware/drivers/servo
            -I${PROJECT_LOC}/../../../firmware/drivers/ssd1306
            -I${PROJECT_LOC}/../../../firmware/drivers/st77xx
            -I${PROJECT_LOC}/../../../firmware/drivers/stepper
            -I${PROJECT_LOC}/../../../apps/include
            -I${PROJECT_LOC}/../../../build/mspm0g3507-launchpad/car_2wd/linkgen
            -I${PROJECT_LOC}/../../../ports/mspm0-driverlib
            -I${PROJECT_LOC}/../../../build/mspm0g3507-launchpad/gen
            -O2
            @device.opt
            -I${COM_TI_MSPM0_SDK_INSTALL_DIR}/source/third_party/CMSIS/Core/Include
            -I${COM_TI_MSPM0_SDK_INSTALL_DIR}/source
            -mcpu=cortex-m0plus
            -march=thumbv6m
            -mfloat-abi=soft
            -mthumb
            -std=c11
            -Wall
            -D__MSPM0G3507__
        "
        linkerBuildOptions="
            -ldevice.cmd.genlibs
            -L${COM_TI_MSPM0_SDK_INSTALL_DIR}/source
            -L${PROJECT_ROOT}
            -L${PROJECT_BUILD_DIR}/syscfg
            -Wl,--rom_model
            -Wl,--warn_sections
            -L${CG_TOOL_ROOT}/lib
            -llibc.a
        "
        sysConfigBuildOptions="
            --output .
            --product ${COM_TI_MSPM0_SDK_INSTALL_DIR}/.metadata/product.json
            --compiler ticlang
        "
        sourceLookupPath="${COM_TI_MSPM0_SDK_INSTALL_DIR}/source/ti/driverlib"
        description="dianzai-workbench：mspm0g3507-launchpad + car_2wd">
        <property name="buildProfile" value="release"/>
        <property name="isHybrid" value="true"/>
        <file path="launchpad.syscfg" openOnCreation="true" excludeFromBuild="false" action="copy"/>
        <file path="${COM_TI_MSPM0_SDK_INSTALL_DIR}/source/ti/devices/msp/m0p/startup_system_files/ticlang/startup_mspm0g350x_ticlang.c" openOnCreation="false" excludeFromBuild="false" targetDirectory="ticlang" action="copy"/>
