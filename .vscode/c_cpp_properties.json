{
  // 【未验证】未在 VS Code 里打开测试；JSON 语法由 make check 校验。说明见 docs/16。
  // 首选第 1 个配置：先跑任务 "dz: compdb"（= make BOARD=.. APP=.. compdb），IntelliSense 用真实编译参数，换板子不用改这里。
  "configurations": [
    {
      "name": "dz (compile_commands)",
      "compileCommands": "${workspaceFolder}/build/compile_commands.json",
      "cStandard": "c11",
      "intelliSenseMode": "gcc-arm"
    },
    {
      // MSPM0 + arm-none-eabi-gcc（本仓库 Makefile 路线）。SDK 版本锁 2.11.00.07（tools/fetch_third_party.sh）
      "name": "MSPM0G3507 · GCC",
      "includePath": [
        "${workspaceFolder}/firmware/**", "${workspaceFolder}/apps/include", "${workspaceFolder}/ports/mspm0-driverlib",
        "${workspaceFolder}/build/mspm0g3507-tianmengxing/gen",
        "${workspaceFolder}/boards/mspm0g3507-tianmengxing/syscfg",
        "${workspaceFolder}/third_party/mspm0-sdk/source",
        "${workspaceFolder}/third_party/mspm0-sdk/source/third_party/CMSIS/Core/Include"
      ],
      "defines": ["__MSPM0G3507__"],
      "compilerPath": "arm-none-eabi-gcc",
      "compilerArgs": ["-mcpu=cortex-m0plus", "-mthumb"],
      "cStandard": "c11",
      "intelliSenseMode": "gcc-arm"
    },
    {
      // MSPM0 + CCS 工程（TI ArmClang / tiarmclang）。CCS 把 SysConfig 生成物放在 <工程>/Debug/ 下，
      // 必须把 Debug/ 加进来，否则 ti_msp_dl_config.h 找不到、DL_ 宏全红。SDK 与编译器路径按你的安装改（版本锁 SDK 2.11.00.07；ti-cgt-armllvm 版本号以 CCS 实际目录为准）。
      "name": "MSPM0G3507 · CCS (TI ArmClang)",
      "includePath": [
        "${workspaceFolder}/firmware/**", "${workspaceFolder}/apps/include", "${workspaceFolder}/ports/mspm0-driverlib",
        "${workspaceFolder}/boards/mspm0g3507-tianmengxing/ccs/Debug",
        "C:/ti/mspm0_sdk_2_11_00_07/source",
        "C:/ti/mspm0_sdk_2_11_00_07/source/third_party/CMSIS/Core/Include",
        "C:/ti/ccs/tools/compiler/ti-cgt-armllvm_4.0.3.LTS/include/c"
      ],
      "defines": ["__MSPM0G3507__"],
      "compilerPath": "C:/ti/ccs/tools/compiler/ti-cgt-armllvm_4.0.3.LTS/bin/tiarmclang.exe",
      "compilerArgs": ["-mcpu=cortex-m0plus", "-mthumb", "--target=arm-arm-none-eabi"],
      "cStandard": "c11",
      "intelliSenseMode": "clang-arm"
    },
    {
      "name": "STM32F407 · GCC",
      "includePath": [
        "${workspaceFolder}/firmware/**", "${workspaceFolder}/apps/include", "${workspaceFolder}/ports/stm32f4-hal",
        "${workspaceFolder}/build/stm32f407-skystar/gen",
        "${workspaceFolder}/third_party/stm32f4xx-hal-driver/Inc", "${workspaceFolder}/third_party/cmsis-device-f4/Include",
        "${workspaceFolder}/third_party/CMSIS_6/CMSIS/Core/Include", "${workspaceFolder}/boards/stm32f407-skystar-cubemx/cubemx/Core/Inc"
      ],
      "defines": ["STM32F407xx", "USE_HAL_DRIVER"],
      "compilerPath": "arm-none-eabi-gcc",
      "compilerArgs": ["-mcpu=cortex-m4", "-mthumb", "-mfloat-abi=hard", "-mfpu=fpv4-sp-d16"],
      "cStandard": "c11",
      "intelliSenseMode": "gcc-arm"
    }
  ],
  "version": 4
}
