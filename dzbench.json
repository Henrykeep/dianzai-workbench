{
  "_doc": "工作台工程配置（进 git，团队共享；不要放密钥）。本机差异放 ~/.dzbench/machine.json。见 docs/17。",
  "flash": {
    "tool": "pyocd",
    "target": "mspm0g3507",
    "dry_run": true
  },
  "build": {
    "elf": "build/car_2wd_mspm0g3507/car_2wd.elf"
  },
  "tune": {
    "vbat_min": null,
    "temp_max": null,
    "max_rounds_hw": 8
  },
  "step_tests": {
    "_doc": "按对象选：遥测里同时有 y 和 sp 两个通道的那一项生效（agent/service.py step_cfg）",
    "car_2wd": {
      "kind": "data",
      "id": 1,
      "fmt": "<ff",
      "low": [
        0,
        0
      ],
      "high": [
        0.4,
        0
      ],
      "pre_s": 0.6,
      "hold_s": 1.5,
      "y": "spd_a",
      "sp": "sp_a",
      "_doc": "car_2wd：DATA id=1 = (v m/s, w rad/s)；0 → 0.4 m/s ≈ 1.96 r/s",
      "gains": {
        "kp": "kp",
        "ki": "ki"
      }
    },
    "2026H_ball": {
      "kind": "data",
      "id": 1,
      "fmt": "<f",
      "low": [
        0
      ],
      "high": [
        60
      ],
      "pre_s": 1.0,
      "hold_s": 4.0,
      "y": "cam_x_px",
      "sp": "ball_sp_px",
      "start": [
        [
          "T",
          1
        ],
        [
          "G"
        ]
      ],
      "_doc": "2026H：DATA id=1 = 钢珠目标 px（f32）；start = 'T'1 选测试 1、'G' 开始；上一轮到了 DONE（state=2）才复位（'R' 也是解除急停，急停时不做实验）。0 → 60 px。仿真钢珠物理是近似模型",
      "state_field": "state",
      "done_state": 2,
      "gains": {
        "kp": "pos_k",
        "ki": "ball_ki"
      }
    },
    "motor_pos": {
      "kind": "data",
      "id": 1,
      "fmt": "<f",
      "low": [
        0
      ],
      "high": [
        90
      ],
      "pre_s": 0.5,
      "hold_s": 1.5,
      "y": "pos_deg",
      "sp": "sp_deg",
      "_doc": "电机位置环：DATA id=1 = 位置设定（f32 度）；0 → 90°。仿真电机是一阶模型",
      "gains": {
        "kp": "kp",
        "ki": "ki",
        "kd": "kd"
      },
      "relay": {
        "rule": "pd_int",
        "loop": 0,
        "amp": 0.3,
        "hyst": 0.5,
        "timeout_s": 10,
        "_doc": "无初值一键起步：板上第 0 个 PID（位置环）输出换成继电 ±0.3（占空比），滞环 0.5°，10 s 后板子自己恢复"
      }
    },
    "pendulum_rot": {
      "kind": "data",
      "id": 1,
      "fmt": "<f",
      "low": [
        0
      ],
      "high": [
        30
      ],
      "pre_s": 1.0,
      "hold_s": 3.0,
      "y": "arm_deg",
      "sp": "sp_arm_deg",
      "_doc": "旋转倒立摆：DATA id=1 = 摆臂角设定（f32 度）；平衡状态下 0 → 30°。不稳定对象，没有开环实验。仿真是近似模型",
      "gains": {
        "kp": "k_th",
        "kd": "k_thd"
      }
    },
    "pan_tilt": {
      "kind": "data",
      "id": 1,
      "fmt": "<f",
      "low": [
        0
      ],
      "high": [
        40
      ],
      "pre_s": 1.0,
      "hold_s": 2.0,
      "y": "tgt_x_px",
      "sp": "aim_x_px",
      "_doc": "视觉云台：DATA id=1 = 瞄准点 x（f32 px）；0 → 40 px，看目标像素多快被拉到瞄准点。仿真相机 30 fps、延迟 50 ms",
      "gains": {
        "kp": "kp",
        "ki": "ki"
      }
    },
    "line_car": {
      "kind": "data",
      "id": 1,
      "fmt": "<f",
      "low": [
        0
      ],
      "high": [
        12
      ],
      "pre_s": 1.0,
      "hold_s": 2.0,
      "y": "line_mm",
      "sp": "line_sp_mm",
      "_doc": "循线：DATA id=1 = 线位置设定（f32 mm）；0 → 12 mm（让车偏一个探头间距跑）。8 路数字灰度量化 12 mm，指标按此看。仿真赛道是正弦线",
      "gains": {
        "kp": "kp_line",
        "kd": "kd_line"
      }
    }
  }
}
