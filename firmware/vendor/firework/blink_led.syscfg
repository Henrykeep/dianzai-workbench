GPIO1.$name                         = "GPIO_LEDS";
GPIO1.associatedPins.create(6);
GPIO1.associatedPins[0].$name        = "USER_LED_1";
GPIO1.associatedPins[0].assignedPin  = "0";
GPIO1.associatedPins[0].initialValue = "SET";
GPIO1.associatedPins[0].pin.$assign  = "PA0";
GPIO1.associatedPins[1].$name        = "RGB_LED_BLUE";
GPIO1.associatedPins[1].initialValue = "CLEARED";
GPIO1.associatedPins[1].pin.$assign  = "PB22";
GPIO1.associatedPins[2].$name        = "RGB_LED_RED";
GPIO1.associatedPins[2].initialValue = "CLEARED";
GPIO1.associatedPins[2].pin.$assign  = "PB26";
GPIO1.associatedPins[3].$name        = "RGB_LED_GREEN";
GPIO1.associatedPins[3].initialValue = "CLEARED";
GPIO1.associatedPins[3].pin.$assign  = "PB27";
GPIO1.associatedPins[4].$name            = "USER_BUTTON_NEXT";
GPIO1.associatedPins[4].direction        = "INPUT";
GPIO1.associatedPins[4].internalResistor = "PULL_DOWN";
GPIO1.associatedPins[4].inputFilter      = "8_CYCLES";
GPIO1.associatedPins[4].pin.$assign      = "PA18";
GPIO1.associatedPins[5].$name            = "USER_BUTTON_PREVIOUS";
GPIO1.associatedPins[5].direction        = "INPUT";
GPIO1.associatedPins[5].internalResistor = "PULL_UP";
GPIO1.associatedPins[5].inputFilter      = "8_CYCLES";
GPIO1.associatedPins[5].pin.$assign      = "PB21";

GPIO2.$name                         = "GPIO_DDS";
GPIO2.associatedPins.create(2);
GPIO2.associatedPins[0].$name        = "AD9833_FSYNC";
GPIO2.associatedPins[0].initialValue = "SET";
GPIO2.associatedPins[0].pin.$assign  = "PB6";
/* AD9850 与 AD9833 共用 SPI1：PB9=SCLK、PB8=SDATA。 */
GPIO2.associatedPins[1].$name        = "AD9850_FQ_UD";
GPIO2.associatedPins[1].initialValue = "CLEARED";
GPIO2.associatedPins[1].pin.$assign  = "PB5";

/* AD9850 RESET 独立使用 PA1；上电保持高电平，确保模块默认无输出。 */
GPIO5.$name                         = "GPIO_AD9850";
GPIO5.associatedPins.create(1);
GPIO5.associatedPins[0].$name        = "AD9850_RESET";
GPIO5.associatedPins[0].initialValue = "SET";
GPIO5.associatedPins[0].pin.$assign  = "PA1";

/* TB6612 双路直流电机方向和待机控制；上电默认全部为低，驱动器保持待机。 */
GPIO6.$name                         = "GPIO_TB6612";
GPIO6.associatedPins.create(5);
GPIO6.associatedPins[0].$name        = "AIN1";
GPIO6.associatedPins[0].initialValue = "CLEARED";
GPIO6.associatedPins[0].pin.$assign  = "PB10";
GPIO6.associatedPins[1].$name        = "AIN2";
GPIO6.associatedPins[1].initialValue = "CLEARED";
GPIO6.associatedPins[1].pin.$assign  = "PB11";
GPIO6.associatedPins[2].$name        = "BIN1";
GPIO6.associatedPins[2].initialValue = "CLEARED";
GPIO6.associatedPins[2].pin.$assign  = "PB14";
GPIO6.associatedPins[3].$name        = "BIN2";
GPIO6.associatedPins[3].initialValue = "CLEARED";
GPIO6.associatedPins[3].pin.$assign  = "PB23";
GPIO6.associatedPins[4].$name        = "STBY";
GPIO6.associatedPins[4].initialValue = "CLEARED";
GPIO6.associatedPins[4].pin.$assign  = "PB25";

GPIO3.$name                         = "GPIO_TFT";
GPIO3.associatedPins.create(3);
GPIO3.associatedPins[0].$name        = "TFT_CS";
GPIO3.associatedPins[0].initialValue = "SET";
GPIO3.associatedPins[0].pin.$assign  = "PB20";
GPIO3.associatedPins[1].$name        = "TFT_DC";
GPIO3.associatedPins[1].initialValue = "CLEARED";
GPIO3.associatedPins[1].pin.$assign  = "PB1";
GPIO3.associatedPins[2].$name        = "TFT_RESET";
GPIO3.associatedPins[2].initialValue = "SET";
GPIO3.associatedPins[2].pin.$assign  = "PB4";

/* 4x4 矩阵键盘：行线空闲时保持高电平，列线使用内部上拉。 */
GPIO4.$name                         = "GPIO_MATRIX_KEYPAD";
GPIO4.associatedPins.create(8);
GPIO4.associatedPins[0].$name        = "ROW_0";
GPIO4.associatedPins[0].initialValue = "SET";
GPIO4.associatedPins[0].pin.$assign  = "PB0";
GPIO4.associatedPins[1].$name        = "ROW_1";
GPIO4.associatedPins[1].initialValue = "SET";
GPIO4.associatedPins[1].pin.$assign  = "PB7";
GPIO4.associatedPins[2].$name        = "ROW_2";
GPIO4.associatedPins[2].initialValue = "SET";
GPIO4.associatedPins[2].pin.$assign  = "PB12";
GPIO4.associatedPins[3].$name        = "ROW_3";
GPIO4.associatedPins[3].initialValue = "SET";
GPIO4.associatedPins[3].pin.$assign  = "PB13";
GPIO4.associatedPins[4].$name            = "COLUMN_0";
GPIO4.associatedPins[4].direction        = "INPUT";
GPIO4.associatedPins[4].internalResistor = "PULL_UP";
GPIO4.associatedPins[4].inputFilter      = "8_CYCLES";
GPIO4.associatedPins[4].pin.$assign      = "PA13";
GPIO4.associatedPins[5].$name            = "COLUMN_1";
GPIO4.associatedPins[5].direction        = "INPUT";
GPIO4.associatedPins[5].internalResistor = "PULL_UP";
GPIO4.associatedPins[5].inputFilter      = "8_CYCLES";
GPIO4.associatedPins[5].pin.$assign      = "PA12";
GPIO4.associatedPins[6].$name            = "COLUMN_2";
GPIO4.associatedPins[6].direction        = "INPUT";
GPIO4.associatedPins[6].internalResistor = "PULL_UP";
GPIO4.associatedPins[6].inputFilter      = "8_CYCLES";
GPIO4.associatedPins[6].pin.$assign      = "PA29";
GPIO4.associatedPins[7].$name            = "COLUMN_3";
GPIO4.associatedPins[7].direction        = "INPUT";
GPIO4.associatedPins[7].internalResistor = "PULL_UP";
GPIO4.associatedPins[7].inputFilter      = "8_CYCLES";
GPIO4.associatedPins[7].pin.$assign      = "PA30";

/* MPU6050 使用独立的 I2C1（PB2=SCL、PB3=SDA）。 */
I2C1.$name                     = "I2C_MPU6050";
I2C1.basicEnableController     = true;
I2C1.basicControllerBusSpeed   = 400000;
I2C1.advAnalogGlitchFilter     = "DISABLED";
I2C1.peripheral.$assign        = "I2C1";
I2C1.peripheral.sclPin.$assign = "PB2";
I2C1.peripheral.sdaPin.$assign = "PB3";

/* OLED 使用独立的 I2C0；PA28/PA31 原先的 PWM 已移到 PA23/PA24。 */
I2C2.$name                     = "I2C_OLED";
I2C2.basicEnableController     = true;
I2C2.basicControllerBusSpeed   = 400000;
I2C2.advAnalogGlitchFilter     = "DISABLED";
I2C2.peripheral.$assign        = "I2C0";
I2C2.peripheral.sdaPin.$assign = "PA28";
I2C2.peripheral.sclPin.$assign = "PA31";

PWM1.$name                          = "PWM_OUTPUT";
PWM1.ccIndex                        = [0,1];
PWM1.pwmMode                        = "EDGE_ALIGN";
PWM1.clockPrescale                  = 32;
PWM1.timerCount                     = 1000;
PWM1.enableShadowLoad               = true;
PWM1.timerStartTimer                = false;
PWM1.peripheral.$assign             = "TIMG7";
PWM1.peripheral.ccp0Pin.$assign     = "PA23";
PWM1.peripheral.ccp1Pin.$assign     = "PA24";
PWM1.PWM_CHANNEL_0.$name            = "PWM_OUTPUT_CHANNEL_0";
PWM1.PWM_CHANNEL_0.dutyCycle        = 50;
PWM1.PWM_CHANNEL_0.ccValue          = 500;
PWM1.PWM_CHANNEL_0.shadowUpdateMode = "ZERO_EVT";
PWM1.PWM_CHANNEL_1.$name            = "PWM_OUTPUT_CHANNEL_1";
PWM1.PWM_CHANNEL_1.dutyCycle        = 50;
PWM1.PWM_CHANNEL_1.ccValue          = 500;
PWM1.PWM_CHANNEL_1.shadowUpdateMode = "ZERO_EVT";

/* TB6612 PWMA/PWMB 共用 TIMA1 周期，默认 20 kHz、0% 占空比并保持停止。 */
PWM2.$name                          = "TB6612_PWM";
PWM2.ccIndex                        = [0,1];
PWM2.pwmMode                        = "EDGE_ALIGN";
PWM2.clockPrescale                  = 1;
PWM2.timerCount                     = 1600;
PWM2.enableShadowLoad               = true;
PWM2.timerStartTimer                = false;
PWM2.peripheral.$assign             = "TIMA1";
PWM2.peripheral.ccp0Pin.$assign     = "PA17";
PWM2.peripheral.ccp1Pin.$assign     = "PA16";
PWM2.PWM_CHANNEL_0.$name            = "TB6612_PWM_CHANNEL_A";
PWM2.PWM_CHANNEL_0.dutyCycle        = 0;
PWM2.PWM_CHANNEL_0.ccValue          = 1600;
PWM2.PWM_CHANNEL_0.shadowUpdateMode = "ZERO_EVT";
PWM2.PWM_CHANNEL_1.$name            = "TB6612_PWM_CHANNEL_B";
PWM2.PWM_CHANNEL_1.dutyCycle        = 0;
PWM2.PWM_CHANNEL_1.ccValue          = 1600;
PWM2.PWM_CHANNEL_1.shadowUpdateMode = "ZERO_EVT";

SPI1.$name                     = "SPI_DDS";
SPI1.targetBitRate             = 1000000;
SPI1.frameFormat               = "MOTO3";
SPI1.polarity                  = "1";
SPI1.phase                     = "0";
SPI1.dataSize                  = 16;
SPI1.bitOrder                  = "MSB";
SPI1.chipSelect                = [];
SPI1.direction                 = "PICO";
SPI1.peripheral.$assign        = "SPI1";
SPI1.peripheral.sclkPin.$assign = "PB9";
SPI1.peripheral.mosiPin.$assign = "PB8";

SPI2.$name                       = "SPI_TFT";
SPI2.targetBitRate               = 8000000;
/* 使用 3-wire 模式并由 GPIO 手动控制 CS，保证命令/数据窗口可控。 */
SPI2.frameFormat                 = "MOTO3";
SPI2.polarity                    = "0";
SPI2.phase                       = "0";
SPI2.dataSize                    = 8;
SPI2.bitOrder                    = "MSB";
SPI2.chipSelect                  = [];
SPI2.direction                   = "PICO";
SPI2.peripheral.$assign          = "SPI0";
SPI2.peripheral.sclkPin.$assign  = "PB18";
SPI2.peripheral.mosiPin.$assign  = "PB17";

TIMER1.$name                       = "ADC_SAMPLE_TIMER";
TIMER1.timerClkSrc                 = "MFCLK";
TIMER1.timerPeriod                 = "1 us";
TIMER1.timerMode                   = "PERIODIC";
TIMER1.event1PublisherChannel      = 1;
TIMER1.event1ControllerInterruptEn = ["ZERO_EVENT"];
TIMER1.event2PublisherChannel      = 4;
TIMER1.event2ControllerInterruptEn = ["ZERO_EVENT"];
TIMER1.peripheral.$assign          = "TIMG0";

UART1.$name                    = "UART_DEBUG";
UART1.enableFIFO               = true;
