COMP1.$name                          = "ANALOG_CAPTURE_COMP_0";
COMP1.compMode                       = "DL_COMP_MODE_FAST";
COMP1.hysteresis                     = "DL_COMP_HYSTERESIS_30";
COMP1.vSource                        = "DL_COMP_REF_SOURCE_VDDA_DAC";
