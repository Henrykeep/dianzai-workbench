 */
ProjectConfig.genDisable = true;

const MFPCLKGate  = system.clockTree["MFPCLKGATE"];
MFPCLKGate.enable = true;
const MFCLKGate  = system.clockTree["MFCLKGATE"];
MFCLKGate.enable = true;

ADC121.$name                      = "ADC_INPUT_0";
ADC121.sampClkSrc                 = "DL_ADC12_CLOCK_ULPCLK";
ADC121.sampClkDiv                 = "DL_ADC12_CLOCK_DIVIDE_1";
ADC121.adcMem0chansel             = "DL_ADC12_INPUT_CHAN_0";
ADC121.adcMem0trig                = "DL_ADC12_TRIGGER_MODE_TRIGGER_NEXT";
ADC121.sampleTime0                = "250 ns";
ADC121.powerDownMode              = "DL_ADC12_POWER_DOWN_MODE_MANUAL";
