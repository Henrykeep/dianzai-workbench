#!/usr/bin/env python3
"""假 ssh：跳过 -o/-i/-p 选项，把远端命令在本机 sh 里跑；HOME 指向 FAKE_SSH_HOME（模拟远端家目录）。
FAKE_SSH_DOWN=1 模拟连不上（退出码 255）。参数记到 FAKE_SSH_LOG。"""
import os, subprocess, sys
a = sys.argv[1:]
if os.environ.get("FAKE_SSH_LOG"):
    with open(os.environ["FAKE_SSH_LOG"], "a") as f: f.write("ssh " + " ".join(a) + "\n")
if os.environ.get("FAKE_SSH_DOWN"):
    sys.stderr.write("ssh: connect to host 10.0.0.9 port 22: No route to host\n"); sys.exit(255)
i = 0
while i < len(a) and a[i].startswith("-"):
    i += 2
cmd = " ".join(a[i + 1:])
env = dict(os.environ, HOME=os.environ.get("FAKE_SSH_HOME", os.environ.get("HOME", "/tmp")))
sys.exit(subprocess.run(["sh", "-c", cmd], env=env, cwd=env["HOME"]).returncode)
